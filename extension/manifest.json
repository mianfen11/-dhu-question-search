{
  "manifest_version": 3,
  "name": "东华手册题目收集器",
  "version": "1.3.0",
  "minimum_chrome_version": "120",
  "description": "正常登录后按用户设置串行收集题库，本地去重、进度恢复与 JSON 导出。",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "题库收集统计"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aidhu.net/",
        "https://aidhu.net/web/*"
      ],
      "js": [
        "entities.js",
        "core.js",
        "handshake.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://aidhu.net/",
        "https://aidhu.net/web/*"
      ],
      "js": [
        "main-bootstrap.js",
        "entities.js",
        "core.js",
        "observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "host_permissions": [
    "https://aidhu.net/",
    "https://aidhu.net/web/*"
  ]
}
