{
  "manifest_version": 3,
  "name": "东华手册题目收集器",
  "version": "1.0.1",
  "minimum_chrome_version": "111",
  "description": "仅在正常练习时保存页面已加载的题目，离线导入与导出 JSON。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "题库收集统计"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aidhu.net/web/*"
      ],
      "js": [
        "entities.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://aidhu.net/web/*"
      ],
      "js": [
        "entities.js",
        "core.js",
        "observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
